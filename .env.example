# MFERM Dashboard Environment Variables
# Copy this file to backend/.env and frontend/.env.local

# ── Backend ──────────────────────────────────────────────────────────────────

# Required: FRED API key — register free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Optional. Earliest date requested from FRED/yfinance for the factor model.
# Default 1990-01-01 if unset — buys dot-com/GFC/COVID stress coverage.
# Some series (dm_fx/DTWEXBGS) don't resolve that far back regardless; see
# the START_DATE comment in backend/data/factor_fetcher.py.
DATA_START=1990-01-01

# Optional. Comma-separated list of origins the FastAPI CORS middleware
# allows, e.g. "https://mferm.vercel.app,https://mferm-preview.vercel.app".
# Defaults to localhost-only if unset — set explicitly in production or
# the deployed frontend's requests will be rejected.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: DATA_SOURCE. "proxy" (default, and the only working value) uses
# free FRED + yfinance. There is no Qi integration in this codebase.
DATA_SOURCE=proxy

# ── Frontend ─────────────────────────────────────────────────────────────────

# Required. Backend base URL — used both for direct client-side fetches
# (lib/api.ts, lib/stirApi.ts) and as the destination for next.config.mjs's
# /api/* rewrite, which the seven standalone module pages depend on.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Shared (both halves read this exact variable name) ────────────────────────

# STIR module gate. Set to "true" for the local demo build.
#
# In the public deploy, set this explicitly to "false" — do NOT just omit
# it from Vercel's env var list. Leaving it genuinely unset (no value from
# any .env file or the platform's env config) means Next.js never finds a
# value to inline at build time, so the process.env.NEXT_PUBLIC_ENABLE_STIR
# check survives in the shipped JS as a real runtime property read instead
# of being eliminated as dead code — which means the STIR nav label and
# other literals ship as unreachable-but-present source even though the
# feature still correctly stays hidden at runtime. Verified directly:
# building with the var truly absent left "STIR" and "ENABLE_STIR" in the
# compiled output; building with it explicitly "false" removed both.
# Frontend reads it at build time (next.config.mjs, Sidebar.tsx,
# app/page.tsx, app/stir/page.tsx); backend reads it at runtime (main.py)
# to conditionally register /api/stir/snapshot. Both must be set the same
# way — see TODO.md item 4 for what "gated" does and doesn't guarantee.
NEXT_PUBLIC_ENABLE_STIR=true
